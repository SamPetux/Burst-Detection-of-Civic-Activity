+            offset += page_size
+            if offset >= response.get("count", 0):
+                return
+
+    def _fetch_thread_tail(
+        self, owner_id: int, post_vk_id: int, root_id: int, *, skip: int, page_size: int,
+    ) -> Iterator[tuple[dict, Optional[int]]]:
+        offset = skip
+        while True:
+            response = self._call(
+                "wall.getComments",
+                owner_id=owner_id, post_id=post_vk_id, comment_id=root_id,
+                count=page_size, offset=offset, need_likes=1,
+            )
+            if not response or not response.get("items"):
+                return
+            for nested in response["items"]:
