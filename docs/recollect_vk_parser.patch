@@ -186,6 +186,10 @@ class VKParser:
             for post in items:
                 post_dt = datetime.fromtimestamp(post["date"])
                 if post_dt < since_dt:
+                    # A pinned post is returned first regardless of its age; stopping on it
+                    # silently drops the whole wall of the group.
+                    if post.get("is_pinned"):
+                        continue
                     return
                 yield post
                 fetched += 1
@@ -225,8 +229,32 @@ class VKParser:
                 yield c, c.get("reply_to_comment")
                 # внутри треда — ответы. parent = id корневого.
                 thread = c.get("thread", {})
-                for nested in thread.get("items", []):
+                items = thread.get("items", [])
+                for nested in items:
                     yield nested, c["id"]
+                # wall.getComments embeds at most thread_items_count replies; hot threads
